{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "base",     "name": "Cool white",  "color": "#FBFCFA" },
				{ "slug": "contrast", "name": "Ink",         "color": "#13261F" },
				{ "slug": "accent-1", "name": "Care green",  "color": "#1B7F5C" },
				{ "slug": "accent-2", "name": "Mist",        "color": "#EAF4EF" },
				{ "slug": "accent-3", "name": "Deep forest", "color": "#0F3B33" },
				{ "slug": "accent-4", "name": "Sage grey",   "color": "#56675F" },
				{ "slug": "accent-5", "name": "Paper",       "color": "#F3F7F4" },
				{ "slug": "accent-6", "name": "Hairline",    "color": "#D7E3DC" },
				{ "slug": "honey",    "name": "Honey",       "color": "#E3B23C" },
				{ "slug": "white",    "name": "Pure white",  "color": "#FFFFFF" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, system-ui, sans-serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2" ],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Manrope"
						}
					]
				},
				{
					"name": "Literata",
					"slug": "literata",
					"fontFamily": "Literata, Georgia, serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/literata/Literata72pt-Regular.woff2" ],
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontFamily": "Literata"
						},
						{
							"src": [ "file:./assets/fonts/literata/Literata72pt-SemiBold.woff2" ],
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontFamily": "Literata"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small",    "name": "Small",    "size": "0.9rem",  "fluid": false },
				{ "slug": "medium",   "name": "Medium",   "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large",    "name": "Large",    "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.3rem" } },
				{ "slug": "x-large",  "name": "X-Large",  "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.9rem" } },
				{ "slug": "xx-large", "name": "XX-Large", "size": "2.6rem",  "fluid": { "min": "2.1rem", "max": "2.9rem" } },
				{ "slug": "display",  "name": "Display",  "size": "3.6rem",  "fluid": { "min": "2.5rem", "max": "4rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"fontWeight": "400"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-1)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-3)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--accent-3)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--literata)",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.3", "letterSpacing": "0" } },
			"button": {
				"border": { "radius": "10px" },
				"color": {
					"background": "var(--wp--preset--color--accent-1)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": { "fontWeight": "700", "fontSize": "1rem" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.4rem", "right": "1.4rem" } },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-3)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		}
	}
}
