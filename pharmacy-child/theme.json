{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base",     "name": "White",        "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Ink",          "color": "#17251F" },
				{ "slug": "accent-1", "name": "Care Green",   "color": "#1B7F5C" },
				{ "slug": "accent-2", "name": "Mint",         "color": "#E8F5EF" },
				{ "slug": "accent-3", "name": "Deep Teal",    "color": "#0E4D4A" },
				{ "slug": "accent-4", "name": "Sage Grey",    "color": "#5B6B64" },
				{ "slug": "accent-5", "name": "Mist",         "color": "#F4F8F6" },
				{ "slug": "accent-6", "name": "Border",       "color": "#D9E5DF" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-1)" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent-3)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent-1)",
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-3)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--accent-3)" },
				"typography": { "fontWeight": "700" }
			}
		}
	}
}
